{
  "name": "wa-control",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "bin": {
    "wa": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "build": "mkdir -p dist && bun build ./src/main.ts --target=bun --compile --outfile ./dist/wa",
    "build:release": "bash ./scripts/build-release.sh all",
    "build:release:linux-x64": "bash ./scripts/build-release.sh linux-x64",
    "build:release:windows-x64": "bash ./scripts/build-release.sh windows-x64",
    "install:local": "bash ./scripts/install-local.sh",
    "check": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.2"
  }
}
